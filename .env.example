# Run backend commands from repository root so .env and relative paths agree.
DATABASE_URL=sqlite:///./data/bazaar.db
POLL_INTERVAL=30
# 1.125%; varies with in-game upgrades. Decimal fraction, not percent.
TAX_RATE=0.01125
ORDER_BOOK_DEPTH=30
METADATA_INTERVAL=3600
HOST=0.0.0.0
PORT=8000
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
COLLECTOR_ENABLED=true
BACKUP_DIRECTORY=backups
BACKUP_RETENTION_DAYS=14
# Set frontend/.env.local on your laptop when connecting to the VM:
# VITE_API_URL=http://YOUR_VM_IP:8000
